<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="12dp"
    android:background="@drawable/ingredient_background">

    <!-- Colour accent bar (colour is set from IngredientAdapter) -->
    <View
        android:id="@+id/ingredientColorAccent"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#6B4FA8" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvIngredientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tomatoes"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_text" />

            <TextView
                android:id="@+id/tvIngredientDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 items"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/app_on_primary_light"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/quantity_badge" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvIngredientExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/app_secondary_text"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvExpiryWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/app_danger"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnEditIngredient"
                app:backgroundTint="@null"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Edit Ingredient"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/app_on_primary_light"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:background="@drawable/edit_button_background" />

            <Button
                android:id="@+id/btnDeleteIngredient"
                app:backgroundTint="@null"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Delete"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/app_danger"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:background="@drawable/delete_button_background" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>