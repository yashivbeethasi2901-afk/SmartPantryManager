<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    tools:context=".PantryActivity">

    <TextView
        android:id="@+id/tvPantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/my_pantry"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/app_primary"
        android:paddingTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keep track of the ingredients in your pantry."
        android:textSize="15sp"
        android:textColor="@color/app_secondary_text"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_pantry_message"
        android:textSize="16sp"
        android:textColor="@color/app_secondary_text"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewIngredients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_ingredient" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick Actions"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/app_secondary_text"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnAddIngredient"
        app:backgroundTint="@null"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="+  Add Ingredient"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/app_on_primary"
        android:textAllCaps="false"
        android:background="@drawable/quick_action_primary"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSuggestedRecipes"
            app:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Suggested Recipes"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/app_primary"
            android:textAllCaps="false"
            android:background="@drawable/quick_action_secondary" />

        <Button
            android:id="@+id/btnSettings"
            app:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Settings"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/app_primary"
            android:textAllCaps="false"
            android:background="@drawable/quick_action_secondary" />

    </LinearLayout>

</LinearLayout>